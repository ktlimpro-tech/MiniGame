# 2026 MiniGame Hub 환경 설정 템플릿
# 로컬 개발 시에는 이 파일을 복사하여 .env 파일을 만들고 실제 값을 입력하세요.
# Render.com 배포 시에는 Render 대시보드의 Environment Variables에 등록하세요.

# 1. 서버 포트 (Render.com은 자동 주입)
PORT=3000
NODE_ENV=production

# 2. 동시 방 개설 최대 상한선 (하드 리밋: 20개 초과 시 대기 상태)
MAX_ROOMS=20

# 3. 관리자 IP 화이트리스트 (쉼표로 구분, 내 공인 IP 등 등록)
ADMIN_IPS=127.0.0.1,::1

# 4. 관리자 모니터링 API 비밀번호 (영문/숫자/특수문자 조합)
ADMIN_PASSWORD=change_this_to_your_secure_password
